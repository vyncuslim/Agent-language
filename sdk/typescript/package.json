{
  "name": "@vaml/runtime",
  "version": "0.2.4-experimental",
  "private": true,
  "description": "Opaque machine semantic Agent-to-Agent runtime",
  "license": "Apache-2.0",
  "vamlRuntimeAudience": "authorized-ai-agents-only",
  "support": {
    "email": "admin@sleepsomno.com"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vaml": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node dist/examples/agent-pair-demo.js",
    "demo:agents": "node dist/examples/autonomous-agent-pair.js",
    "demo:chat": "node dist/examples/chat-learning-demo.js",
    "demo:audio": "node dist/examples/acoustic-frame-demo.js",
    "demo:text": "node dist/examples/text-transport-demo.js",
    "demo:agents-chat": "node dist/examples/agent-chat-demo.js",
    "chat:lan": "node tools/lan-chat-server.mjs",
    "test:audio:live": "tsx tools/live-acoustic-test-server.ts",
    "vaml": "node dist/src/cli.js",
    "pack": "tsx tools/build-private-lexicon.ts",
    "pack:world": "tsx tools/build-world-lexicon.ts",
    "privacy:lint": "tsx tools/privacy-lint.ts ../..",
    "benchmark": "node --expose-gc dist/bench/vocabulary.js",
    "check": "npm run build && npm test && npm run demo && npm run demo:agents && npm run demo:chat && npm run privacy:lint",
    "privacy": "tsx tools/privacy-lint.ts ../..",
    "world-pack": "tsx tools/build-world-lexicon.ts",
    "corpus-pack": "tsx tools/build-world-semantic-corpus.ts",
    "corpus:omw": "tsx tools/build-omw-corpus.ts",
    "acoustic:evidence": "tsx tools/analyze-acoustic-evidence.ts",
    "private-corpus-run": "tsx tools/run-private-corpus-build.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
