{
  "name": "@vaml/runtime",
  "version": "0.2.4-experimental",
  "private": true,
  "description": "Opaque machine semantic Agent-to-Agent runtime",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vaml": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node dist/examples/agent-pair-demo.js",
    "demo:agents": "node dist/examples/autonomous-agent-pair.js",
    "vaml": "node dist/src/cli.js",
    "pack": "tsx tools/build-private-lexicon.ts",
    "pack:world": "tsx tools/build-world-lexicon.ts",
    "privacy:lint": "tsx tools/privacy-lint.ts ../..",
    "benchmark": "node --expose-gc dist/bench/vocabulary.js",
    "check": "npm run build && npm test && npm run demo && npm run demo:agents && npm run privacy:lint",
    "privacy": "tsx tools/privacy-lint.ts ../..",
    "world-pack": "tsx tools/build-world-lexicon.ts",
    "corpus-pack": "tsx tools/build-world-semantic-corpus.ts",
    "private-corpus-run": "tsx tools/run-private-corpus-build.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
