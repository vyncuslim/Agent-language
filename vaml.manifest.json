  "agent_learning_objectives": [
    "load authorized encrypted semantic packs without requiring public labels",
    "ingest very large multilingual concept spaces through private sorted corpus streams",
    "combine registered lexical, morphology, entity, science-math, programming, model-generated and agent-native sources",
    "normalize Source Pack 1 candidates through private semantic alignment before CorpusRow creation",
    "verify private source snapshots, source policy files and alignment material by SHA-256 before use",
    "keep source snapshots, alignment material, plaintext sorted corpus and build receipts outside the public repository",
    "sort large private corpora with bounded memory and remove exact duplicate normalized rows",
    "build content-addressed encrypted vocabulary shards and a pinned encrypted catalog",
    "enforce explicit source license metadata and conservative redistribution defaults",
    "preserve private provenance and semantic evidence without publishing a word-to-code mapping",
    "represent concepts that have no human-language alias",
    "learn opaque concept exposure and concept-to-concept associations",
    "create provisional agent-native concepts from permitted model observations and outcomes",
    "promote learned concepts only after configured exposure and confidence thresholds",
    "persist and restore private adaptive semantic memory without human-readable labels",
    "derive a bounded encrypted active-set session codebook with a peer",
    "keep one authenticated session across many Agent-to-Agent conversation turns",
    "attach opaque conversation, message and reply identities inside encrypted message payloads",
    "expand the active concept set during an existing conversation without full-vocabulary negotiation",
    "retain bounded private semantic conversation context and expose per-turn learning hooks",
    "connect a model-neutral AI Agent brain directly to VAML semantic messages",
    "allow two independent Agent brains to communicate autonomously without human turn-by-turn control",
    "support different model vendors and model architectures through the same VamlAgentBrain interface",
    "carry already-encrypted VAML frames over audible acoustic modulation without assigning sounds to semantic concepts",
    "recover live microphone packets despite bounded sample-clock mismatch and arbitrary audio callback chunk boundaries",
    "use preamble synchronization and adaptive symbol timing before returning acoustic frames to VAML",
    "preserve explicit browser microphone permission and keep speech DSP disabled by default for modem tones",
    "keep acoustic modulation separate from semantic meaning and cryptographic authority",
    "compile opaque .vaml machine IR into authenticated encrypted frames",
    "reject unknown or non-negotiated concepts instead of guessing",
    "enforce replay protection and treat protocol validity as separate from authorization",
    "keep semantic learning separate from security authority and executable-code modification"
  ],
  "core_principles": [
    "no-public-word-to-opcode-table",
    "concepts-not-words",
    "private-semantic-packs",
    "world-semantic-corpus-via-private-ingestion",
    "registered-source-provenance",
    "source-adapter-normalization",
    "source-pack-license-gates",
    "private-alignment-before-corpus",
    "checksum-pinned-private-build-inputs",
    "bounded-memory-private-corpus-sorting",
    "private-build-receipts",
    "fail-closed-missing-alignment",
    "cross-source-sense-alignment",
    "agent-native-concepts-without-required-words",
    "streaming-sharded-vocabulary",
    "agent-learning-with-opaque-identities",
    "adaptive-agent-native-learning-with-promotion-gates",
    "persistent-multi-turn-agent-conversation",
    "autonomous-agent-to-agent-brain-bridge",
    "model-neutral-agent-interoperability",
    "audible-acoustic-byte-transport-not-sound-semantics",
    "adaptive-acoustic-clock-recovery",
    "bounded-live-microphone-buffering",
    "browser-microphone-permission-boundary",
    "dynamic-active-set-expansion-during-conversation",
    "bounded-private-conversation-context",
    "semantic-learning-does-not-grant-security-authority",
    "private-agent-conversations-use-controlled-human-translation-boundary",
    "session-randomized-codebook",
    "zero-chatter",
    "typed-values",
    "dynamic-vocabulary-negotiation",
    "authenticated-encryption",
    "replay-protection",
    "multilingual-import",
    "model-neutral",
    "privacy-lint-on-public-repository"
