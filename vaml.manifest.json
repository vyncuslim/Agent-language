{
  "name": "VAML",
  "full_name": "Vynalth Agent Machine Language",
  "protocol_version": "0.2",
  "release": "0.2.1-experimental",
  "purpose": "Opaque machine-native semantic communication between AI agents.",
  "human_language": false,
  "public_semantic_dictionary": false,
  "wire_model": "x25519-hkdf-session-codebook+aead-binary-tlv",
  "semantic_model": "private-encrypted-concept-packs",
  "entrypoints": {
    "agent_instructions": "AGENTS.md",
    "specification": "spec/VAML-0.2.md",
    "vocabulary_architecture": "spec/VOCABULARY-0.2.md",
    "world_lexicon_architecture": "spec/WORLD-LEXICON-0.2.md",
    "agent_learning_model": "spec/AGENT-LEARNING-0.2.md",
    "typescript_runtime": "sdk/typescript/src/index.ts",
    "vaml_compiler": "sdk/typescript/src/compiler.ts",
    "semantic_index": "sdk/typescript/src/semantic-index.ts",
    "world_lexicon": "sdk/typescript/src/world-lexicon.ts",
    "agent_learner": "sdk/typescript/src/learning.ts",
    "vocabulary_builder": "sdk/typescript/tools/build-private-lexicon.ts",
    "world_vocabulary_builder": "sdk/typescript/tools/build-world-lexicon.ts",
    "privacy_lint": "sdk/typescript/tools/privacy-lint.ts",
    "agent_pair_demo": "sdk/typescript/examples/agent-pair-demo.ts",
    "runtime_tests": "sdk/typescript/test/runtime.test.ts",
    "world_lexicon_tests": "sdk/typescript/test/world-lexicon.test.ts"
  },
  "learning_order": [
    "AGENTS.md",
    "spec/VAML-0.2.md",
    "spec/VOCABULARY-0.2.md",
    "spec/WORLD-LEXICON-0.2.md",
    "spec/AGENT-LEARNING-0.2.md",
    "sdk/typescript/src/types.ts",
    "sdk/typescript/src/lexicon.ts",
    "sdk/typescript/src/semantic-index.ts",
    "sdk/typescript/src/world-lexicon.ts",
    "sdk/typescript/src/learning.ts",
    "sdk/typescript/src/negotiation.ts",
    "sdk/typescript/src/runtime.ts",
    "sdk/typescript/src/compiler.ts",
    "sdk/typescript/examples/agent-pair-demo.ts"
  ],
  "agent_learning_objectives": [
    "load authorized encrypted semantic packs without requiring public labels",
    "ingest very large multilingual concept spaces through private sorted lexicon streams",
    "map human-language edge input into private concepts without using natural language as the wire protocol",
    "learn opaque concept exposure and concept-to-concept associations",
    "use vectors and machine semantic records as first-class internal representations",
    "map internal semantic concepts to private concept identities",
    "derive a fresh session-local codebook with a peer",
    "compile opaque .vaml machine IR into authenticated encrypted frames",
    "decode negotiated session codes back into private internal concepts",
    "reject unknown or non-negotiated concepts instead of guessing",
    "enforce replay protection and treat protocol validity as separate from authorization"
  ],
  "core_principles": [
    "no-public-word-to-opcode-table",
    "concepts-not-words",
    "private-semantic-packs",
    "world-lexicon-via-private-ingestion",
    "streaming-sharded-vocabulary",
    "agent-learning-with-opaque-identities",
    "session-randomized-codebook",
    "zero-chatter",
    "typed-values",
    "dynamic-vocabulary-negotiation",
    "authenticated-encryption",
    "replay-protection",
    "multilingual-import",
    "model-neutral",
    "privacy-lint-on-public-repository"
  ],
  "privacy_modes": ["debug", "opaque", "sealed"],
  "compatibility": {
    "major": 0,
    "minor": 2,
    "patch": 1,
    "wire_compatible_with": "0.2.0",
    "v0_1": "retired-and-not-decodable-by-v0_2",
    "missing_private_pack": "reject",
    "unknown_session_code": "reject",
    "semantic_guessing": "forbidden"
  }
}
