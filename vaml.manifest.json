{
  "name": "VAML",
  "full_name": "Vynalth Agent Machine Language",
  "protocol_version": "0.2",
  "release": "0.2.4-experimental",
  "purpose": "Opaque machine-native semantic communication between AI agents.",
  "human_language": false,
  "public_semantic_dictionary": false,
  "wire_model": "x25519-psk-hkdf-directional-aead+encrypted-active-set",
  "semantic_model": "private-encrypted-concept-packs",
  "corpus_model": "private-source-registry+cross-source-alignment+verified-offline-build+encrypted-shards",
  "entrypoints": {
    "agent_instructions": "AGENTS.md",
    "specification": "spec/VAML-0.2.md",
    "vocabulary_architecture": "spec/VOCABULARY-0.2.md",
    "world_lexicon_architecture": "spec/WORLD-LEXICON-0.2.md",
    "world_semantic_corpus": "spec/WORLD-SEMANTIC-CORPUS-0.1.md",
    "corpus_source_pack_1": "spec/CORPUS-SOURCE-PACK-1.md",
    "private_corpus_runner_spec": "spec/PRIVATE-CORPUS-RUNNER-0.1.md",
    "private_corpus_build_plan_schema": "spec/schema/private-corpus-build-plan-0.1.schema.json",
    "private_alignment_manifest_schema": "spec/schema/private-alignment-manifest-0.1.schema.json",
    "private_alignment_shard_schema": "spec/schema/private-alignment-shard-0.1.schema.json",
    "corpus_source_schema": "spec/schema/corpus-sources-0.1.schema.json",
    "corpus_row_schema": "spec/schema/corpus-row-0.1.schema.json",
    "agent_learning_model": "spec/AGENT-LEARNING-0.2.md",
    "typescript_runtime": "sdk/typescript/src/index.ts",
    "vaml_compiler": "sdk/typescript/src/compiler.ts",
    "semantic_index": "sdk/typescript/src/semantic-index.ts",
    "world_lexicon": "sdk/typescript/src/world-lexicon.ts",
    "corpus_assembler": "sdk/typescript/src/corpus.ts",
    "corpus_source_adapter": "sdk/typescript/src/source-adapter.ts",
    "corpus_source_pack_1_adapter": "sdk/typescript/src/source-pack-1.ts",
    "private_corpus_runner": "sdk/typescript/src/private-corpus-runner.ts",
    "private_corpus_runner_cli": "sdk/typescript/tools/run-private-corpus-build.ts",
    "agent_learner": "sdk/typescript/src/learning.ts",
    "vocabulary_builder": "sdk/typescript/tools/build-private-lexicon.ts",
    "world_vocabulary_builder": "sdk/typescript/tools/build-world-lexicon.ts",
    "corpus_builder": "sdk/typescript/tools/build-world-semantic-corpus.ts",
    "privacy_lint": "sdk/typescript/tools/privacy-lint.ts",
    "agent_pair_demo": "sdk/typescript/examples/agent-pair-demo.ts",
    "runtime_tests": "sdk/typescript/test/runtime.test.ts",
    "world_lexicon_tests": "sdk/typescript/test/world-lexicon.test.ts",
    "corpus_tests": "sdk/typescript/test/corpus.test.ts",
    "source_pack_1_tests": "sdk/typescript/test/source-pack-1.test.ts",
    "private_corpus_runner_tests": "sdk/typescript/test/private-corpus-runner.test.ts",
    "network_transport": "sdk/typescript/src/transport.ts",
    "benchmark": "sdk/typescript/bench/vocabulary.ts",
    "cli": "sdk/typescript/src/cli.ts",
    "sharded_index": "sdk/typescript/src/vocabulary.ts"
  },
  "learning_order": [
    "AGENTS.md",
    "spec/VAML-0.2.md",
    "spec/VOCABULARY-0.2.md",
    "spec/WORLD-LEXICON-0.2.md",
    "spec/WORLD-SEMANTIC-CORPUS-0.1.md",
    "spec/CORPUS-SOURCE-PACK-1.md",
    "spec/PRIVATE-CORPUS-RUNNER-0.1.md",
    "spec/AGENT-LEARNING-0.2.md",
    "sdk/typescript/src/types.ts",
    "sdk/typescript/src/lexicon.ts",
    "sdk/typescript/src/semantic-index.ts",
    "sdk/typescript/src/world-lexicon.ts",
    "sdk/typescript/src/corpus.ts",
    "sdk/typescript/src/source-adapter.ts",
    "sdk/typescript/src/source-pack-1.ts",
    "sdk/typescript/src/private-corpus-runner.ts",
    "sdk/typescript/src/learning.ts",
    "sdk/typescript/src/vocabulary.ts",
    "sdk/typescript/src/negotiation.ts",
    "sdk/typescript/src/runtime.ts",
    "sdk/typescript/src/transport.ts",
    "sdk/typescript/src/compiler.ts",
    "sdk/typescript/examples/agent-pair-demo.ts"
  ],
  "agent_learning_objectives": [
    "load authorized encrypted semantic packs without requiring public labels",
    "ingest very large multilingual concept spaces through private sorted corpus streams",
    "combine registered lexical, morphology, entity, science-math, programming, model-generated and agent-native sources",
    "normalize Source Pack 1 candidates through private semantic alignment before CorpusRow creation",
    "verify private source snapshots, source policy files and alignment material by SHA-256 before use",
    "keep source snapshots, alignment material, plaintext sorted corpus and build receipts outside the public repository",
    "sort large private corpora with bounded memory and remove exact duplicate normalized rows",
    "build content-addressed encrypted vocabulary shards and a pinned encrypted catalog",
    "enforce explicit source license metadata and conservative redistribution defaults",
    "preserve private provenance and semantic evidence without publishing a word-to-code mapping",
    "represent concepts that have no human-language alias",
    "learn opaque concept exposure and concept-to-concept associations",
    "derive a bounded encrypted active-set session codebook with a peer",
    "compile opaque .vaml machine IR into authenticated encrypted frames",
    "reject unknown or non-negotiated concepts instead of guessing",
    "enforce replay protection and treat protocol validity as separate from authorization"
  ],
  "core_principles": [
    "no-public-word-to-opcode-table",
    "concepts-not-words",
    "private-semantic-packs",
    "world-semantic-corpus-via-private-ingestion",
    "registered-source-provenance",
    "source-adapter-normalization",
    "source-pack-license-gates",
    "private-alignment-before-corpus",
    "checksum-pinned-private-build-inputs",
    "bounded-memory-private-corpus-sorting",
    "private-build-receipts",
    "fail-closed-missing-alignment",
    "cross-source-sense-alignment",
    "agent-native-concepts-without-required-words",
    "streaming-sharded-vocabulary",
    "agent-learning-with-opaque-identities",
    "session-randomized-codebook",
    "zero-chatter",
    "typed-values",
    "dynamic-vocabulary-negotiation",
    "authenticated-encryption",
    "replay-protection",
    "multilingual-import",
    "model-neutral",
    "privacy-lint-on-public-repository"
  ],
  "privacy_modes": ["debug", "opaque", "sealed"],
  "compatibility": {
    "major": 0,
    "minor": 2,
    "patch": 4,
    "wire_compatible_with": "0.2.4-experimental",
    "corpus_spec": "0.1",
    "source_pack_1": "0.1",
    "private_corpus_runner": "0.1",
    "v0_1": "retired-and-not-decodable-by-v0_2",
    "missing_private_pack": "reject",
    "unknown_session_code": "reject",
    "semantic_guessing": "forbidden"
  }
}
