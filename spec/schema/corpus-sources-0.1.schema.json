{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vynalthai.com/vaml/schema/corpus-sources-0.1.schema.json",
  "title": "VAML Corpus Source Registry 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "sources"],
  "properties": {
    "format": { "const": "vaml-corpus-sources" },
    "version": { "const": "0.1" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "license", "redistribution"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "dictionary",
              "lexical-knowledge-base",
              "encyclopedic",
              "terminology",
              "morphology",
              "entity",
              "programming",
              "organization-private",
              "model-generated",
              "agent-native"
            ]
          },
          "license": { "type": "string", "minLength": 1 },
          "redistribution": {
            "enum": ["private-only", "metadata-only", "redistributable"]
          },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "domains": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "embeddingSpace": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
