{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaml.invalid/schema/private-corpus-build-plan-0.1.schema.json",
  "title": "VAML Private Corpus Build Plan 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "runId", "sourceManifest", "snapshots", "alignmentManifest", "tempDir", "output"],
  "properties": {
    "format": { "const": "vaml-private-corpus-build-plan" },
    "version": { "const": "0.1" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sourceManifest": { "$ref": "#/$defs/digestFile" },
    "alignmentManifest": { "$ref": "#/$defs/digestFile" },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceId", "path", "sha256", "format"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
          "format": { "const": "source-pack-1-candidate-jsonl" }
        }
      }
    },
    "tempDir": { "type": "string", "minLength": 1 },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "prefix"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minQuality": { "type": "number", "minimum": 0, "maximum": 1 },
        "missingAlignment": { "enum": ["reject", "skip"] },
        "chunkRows": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "mergeFanIn": { "type": "integer", "minimum": 1, "maximum": 256 },
        "cleanupTemp": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "digestFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    }
  }
}
